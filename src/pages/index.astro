---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromoBar from '../components/PromoBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AgendaTable from '../components/AgendaTable.astro';
import bourses from '../data/bourses.json';
import { isPastDateText, parseDateFR, startOfToday } from '../lib/dates';
import type { Bourse } from '../lib/types';

const today = startOfToday();
const allEvents = bourses as Bourse[];

const withDates = allEvents.map((event) => ({
  event,
  parsed: parseDateFR(event.dates),
}));

const upcoming = withDates
  .filter(({ event, parsed }) => !isPastDateText(event.dates, today))
  .sort((a, b) => {
    const ta = a.parsed?.startDate.getTime() ?? Number.MAX_SAFE_INTEGER;
    const tb = b.parsed?.startDate.getTime() ?? Number.MAX_SAFE_INTEGER;
    return ta - tb;
  })
  .map(({ event }) => event);

const archives = withDates
  .filter(({ event }) => isPastDateText(event.dates, today))
  .sort((a, b) => {
    const ta = a.parsed?.startDate.getTime() ?? 0;
    const tb = b.parsed?.startDate.getTime() ?? 0;
    return tb - ta;
  })
  .map(({ event }) => event);
---
<BaseLayout title="Bourses Horlogères Européennes 2025-2026">
  <link rel="stylesheet" href="/styles/home.css" slot="head" />
  <script src="/scripts/agenda.js" slot="head"></script>

  <PromoBar />
  <SiteHeader />

  <section class="hero">
    <div class="hero-content">
      <h1>Ne cherchez plus, on l'a fait pour vous</h1>
      <p>
        Voici la liste exhaustive des bourses horlogères européennes.
        Retrouvez toutes les informations essentielles pour organiser votre visite
        et ne manquer aucun événement important.
      </p>
      <a href="#agenda" class="cta-button">Voir l'agenda</a>
    </div>
    <img src="/image_placeholder.jpg" alt="Illustration bourse horlogère" />
  </section>

  <section class="agenda-section agenda-section--upcoming" id="agenda">
    <div class="agenda-heading">
      <h2>Prochaines bourses</h2>
      <span class="agenda-count">{upcoming.length} événement{upcoming.length > 1 ? 's' : ''}</span>
    </div>
    <p class="agenda-lead">Les dates à venir, triées chronologiquement.</p>
    <div class="agenda-actions" data-scope="upcoming"></div>

    {upcoming.length > 0 ? (
      <AgendaTable events={upcoming} variant="upcoming" />
    ) : (
      <p class="agenda-empty">Aucune bourse à venir pour le moment. Consultez les archives ci-dessous.</p>
    )}
  </section>

  {archives.length > 0 && (
    <section class="agenda-section agenda-section--archives" id="archives">
      <details class="archives-panel">
        <summary class="archives-summary">
          <span class="archives-summary__title">Archives — événements passés</span>
          <span class="agenda-count agenda-count--muted">{archives.length}</span>
        </summary>
        <p class="agenda-lead agenda-lead--archives">Historique des éditions déjà passées.</p>
        <AgendaTable events={archives} variant="archives" />
      </details>
    </section>
  )}

  <section class="about-section" id="about">
    <h2>Qui sommes-nous ?</h2>
    <p>L'HorloBroc est une référence dans le domaine des montres anciennes et de collection.</p>
    <p>
      Fondé par Pierre Eugène Lebret, passionné d'horlogerie,
      L'HorloBroc organise des événements et rassemble les passionnés du temps et de son art.
    </p>
  </section>

  <section class="contact-section" id="contact">
    <h2>Vous organisez une bourse horlogère ?</h2>
    <p>
      Apparaître en détail dans notre agenda, sponsoriser un événement ou promouvoir vos services auprès de milliers de
      passionnés ? Écrivez-nous et créons ensemble une mise en avant sur-mesure.
    </p>
    <a
      class="cta-button"
      href="mailto:contact@lagenda-des-bourses-horlogeres.com?subject=Demande%20de%20mise%20en%20avant"
    >
      Demander une mise en avant
    </a>
  </section>

  <footer>
    <p>Propulsé par <a href="http://lhorlobroc.shop" target="_blank">l'horlobroc</a></p>
    <p>
      N'hésitez pas à nous retrouver sur nos réseaux sociaux
      et faire un tour sur le site pour ne rien manquer des nouveautés !
    </p>
  </footer>
</BaseLayout>
